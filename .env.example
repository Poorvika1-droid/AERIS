# AERIS prototype — never commit real credentials
AERIS_ENV=demo
AERIS_DATA_MODE=demonstration
SECRET_KEY=change-me-in-any-non-demo-environment
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Local default (no database server required). Docker Compose overrides this with MySQL.
DATABASE_URL=sqlite:///../../data/demo/aeris.db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=aeris-trust-engine

# Optional operational adapters (leave empty in demo mode)
NWP_BASE_URL=
NWP_API_KEY=
OBS_BASE_URL=
OBS_API_KEY=
SATELLITE_BASE_URL=
RADAR_BASE_URL=

AUTH_DISABLED=true
DEFAULT_ROLE=VIEWER

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_DATA_MODE=demonstration
